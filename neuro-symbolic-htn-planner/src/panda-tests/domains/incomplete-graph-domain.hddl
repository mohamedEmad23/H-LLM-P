(define (domain incomplete-graph-traversal)
  (:requirements :typing :hierarchy :negative-preconditions)
  
  (:types
    node - object
    edge - object
  )
  
  (:predicates
    (at ?n - node)                    ; Current position
    (connected ?from ?to - node)      ; Edge exists
    (edge-weight-known ?from ?to - node)  ; Weight is known
    (visited ?n - node)               ; Node has been visited
    (goal-node ?n - node)             ; Target node
    (path-complete)                   ; Goal achieved
  )
  
  (:functions
    (weight ?from ?to - node) - number  ; Edge weight (may be unknown)
    (total-cost) - number               ; Accumulated path cost
  )
  
  ;; Abstract task: Find shortest path with unknown edges
  (:task find-path
    :parameters (?start ?end - node))
  
  ;; Abstract task: Resolve unknown edge weight
  (:task resolve-unknown-weight
    :parameters (?from ?to - node))
  
  ;; Method: Find path when edge weight is known
  (:method path-with-known-weights
    :parameters (?start ?intermediate ?end - node)
    :task (find-path ?start ?end)
    :precondition (and
      (connected ?start ?intermediate)
      (connected ?intermediate ?end)
      (edge-weight-known ?start ?intermediate)
      (edge-weight-known ?intermediate ?end)
    )
    :subtasks (and
      (task1 (traverse ?start ?intermediate))
      (task2 (traverse ?intermediate ?end))
    )
    :ordering (and
      (task1 < task2)
    )
  )
  
  ;; Method: Find path when edge weight is unknown - must resolve first
  (:method path-with-unknown-weights
    :parameters (?start ?intermediate ?end - node)
    :task (find-path ?start ?end)
    :precondition (and
      (connected ?start ?intermediate)
      (connected ?intermediate ?end)
      (not (edge-weight-known ?intermediate ?end))
    )
    :subtasks (and
      (task1 (resolve-unknown-weight ?intermediate ?end))
      (task2 (traverse ?start ?intermediate))
      (task3 (traverse ?intermediate ?end))
    )
    :ordering (and
      (task1 < task2)
      (task2 < task3)
    )
  )
  
  ;; Method: Resolve unknown weight by querying knowledge base
  (:method query-knowledge-base
    :parameters (?from ?to - node)
    :task (resolve-unknown-weight ?from ?to)
    :subtasks (and
      (task1 (query-weight ?from ?to))
    )
  )
  
  ;; Primitive action: Query knowledge base for edge weight
  (:action query-weight
    :parameters (?from ?to - node)
    :precondition (and
      (connected ?from ?to)
      (not (edge-weight-known ?from ?to))
    )
    :effect (and
      (edge-weight-known ?from ?to)
    )
  )
  
  ;; Primitive action: Traverse an edge
  (:action traverse
    :parameters (?from ?to - node)
    :precondition (and
      (at ?from)
      (connected ?from ?to)
      (edge-weight-known ?from ?to)
      (not (visited ?to))
    )
    :effect (and
      (at ?to)
      (visited ?to)
      (not (at ?from))
      (increase (total-cost) (weight ?from ?to))
    )
  )
  
  ;; Primitive action: Mark path as complete
  (:action complete-path
    :parameters (?end - node)
    :precondition (and
      (at ?end)
      (goal-node ?end)
    )
    :effect (and
      (path-complete)
    )
  )
)
